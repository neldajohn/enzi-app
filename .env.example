# Copy this file to `.env` and fill in your own Cloudinary values to enable
# item photo uploads. Without these, the app still works — it just skips
# saving a photo and shows a small notice.
#
# 1. Sign up free at https://cloudinary.com
# 2. Your cloud name is on the dashboard home page.
# 3. Create an unsigned upload preset: Settings -> Upload -> Upload presets
#    -> Add upload preset -> set "Signing Mode" to "Unsigned" -> Save.
#    Use that preset's name below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
